# A URL may include /api/v1 or just the institution's HTTPS origin.
CANVAS_API_URL=https://pucminas.instructure.com/api/v1
CANVAS_API_TOKEN=
# Optional reminder supplied by you; this does not set Canvas's expiry.
CANVAS_TOKEN_EXPIRES_AT=
CANVAS_DEFAULT_COURSE_ID=
CANVAS_TIMEZONE=America/Sao_Paulo
# Set true to omit write/upload/mutation tools and reject writes in the client.
CANVAS_READ_ONLY=false
# Optional, used only by canvas-weekly-check --telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
