# A URL may include /api/v1 or just the institution's HTTPS origin.
CANVAS_API_URL=https://canvas.example.edu/api/v1
CANVAS_API_TOKEN=
# Optional reminder supplied by you; this does not set Canvas's expiry.
CANVAS_TOKEN_EXPIRES_AT=
CANVAS_DEFAULT_COURSE_ID=
CANVAS_TIMEZONE=UTC
# Start with reads only. Set false deliberately to enable writes/uploads/submissions.
CANVAS_READ_ONLY=true
# false: wait for your request; true: authorize the local daily worker to solve AND submit.
# The worker checks pending assignments in all active courses at 08:00 local time.
CANVAS_AGENT_AUTO=false
# Chosen by canvas-agent setup. Empty means no implicit choice of agent.
CANVAS_AGENT_PROVIDER=
# Used by optional reminders and the local agent. No model API key is required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
